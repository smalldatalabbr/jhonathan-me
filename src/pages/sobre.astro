---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { aboutContent } from "../config/content.ts";
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{aboutContent.meta.title}</title>
    <meta name="description" content={aboutContent.meta.description} />

    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) document.documentElement.classList.add("dark");
              else document.documentElement.classList.remove("dark");
            }
          });
      });
    </script>

    <style>
      .dot-hexagon-light {
        background-image: radial-gradient(circle, #80808045 1px, transparent 1px),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(circle, #ffffff35 1px, transparent 1px),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }
    </style>
  </head>

  <body class="min-h-screen flex flex-col bg-white dark:bg-black transition-colors duration-300">
    <div class="relative flex-grow flex flex-col">

      <!-- Grid (sem degradê / sem glow extra) -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute inset-0 dot-hexagon-light dark:dot-hexagon-dark"></div>
      </div>

      <Navigation />

      <section class="relative z-20 w-full max-w-6xl mx-auto mt-20 mb-12 px-4 sm:px-6 lg:px-8">
        <div class="relative z-20 w-full mx-auto lg:mx-0">
          <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl">
            {aboutContent.title}
          </h2>

          <div class="flex flex-col md:flex-row gap-8 mt-3 sm:mt-4 lg:mt-6">
            <!-- Coluna esquerda -->
            <div class="w-full md:w-[55%] flex flex-col">
              <p class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg whitespace-pre-line">
                {aboutContent.description}
              </p>

              <div class="mt-auto pt-4 flex flex-wrap gap-2">
                {
                  aboutContent.skills.map((skill) => (
                    <span class="px-3 py-1 text-sm bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-200 rounded-full">
                      {skill}
                    </span>
                  ))
                }
              </div>
            </div>

            <!-- Coluna direita -->
            <div class="w-full md:w-[45%] flex justify-end">
              <div class="w-[360px] flex flex-col gap-6">
                <div class="relative w-[360px] h-[360px]">
                  <img
                    src={aboutContent.image.src}
                    alt={aboutContent.image.alt}
                    class="object-cover rounded-xl w-full h-full"
                  />
                </div>

                <!-- Formação acadêmica abaixo da foto -->
                <div>
                  <h3 class="mb-2 text-xl font-bold text-neutral-900 dark:text-neutral-100">
                    {aboutContent.education.title}
                  </h3>

                  <div class="space-y-3">
                    {
                      aboutContent.education.items.map((ed) => (
                        <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/60 dark:bg-black/40 px-4 py-3">
                          <p class="text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                            {ed.period}
                          </p>
                          <p class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                            {ed.course}
                          </p>
                          <p class="text-sm text-neutral-600 dark:text-neutral-400">
                            {ed.institution}
                          </p>
                        </div>
                      ))
                    }
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>

        <!-- Linha de baixo -->
        <div class="flex flex-col md:flex-row mt-20">
          <!-- Experiência -->
          <div class="flex-1">
            <h2 class="mb-2 text-2xl font-bold text-neutral-900 dark:text-neutral-200">
              {aboutContent.experience.title}
            </h2>

            <div class="py-10">
              {
                aboutContent.experience.items.map((item) => (
                  <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-800">
                    <div class="relative flex flex-col justify-start pl-12">
                      <div class="absolute top-0 left-0 z-40 flex items-center justify-center -translate-x-1/2 bg-white border rounded-full dark:bg-black w-14 h-14 border-neutral-300 dark:border-neutral-800">
                        <svg
                          class="w-8 h-8 text-neutral-700 dark:text-neutral-300"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                          />
                        </svg>
                      </div>

                      <p class="text-xs uppercase text-neutral-500 dark:text-neutral-500 tracking-widest">
                        {item.period}
                      </p>
                      <h3 class="my-1 text-lg font-bold text-neutral-900 dark:text-neutral-100">
                        {item.position}
                      </h3>
                      <p class="mb-1 text-sm font-medium text-neutral-700 dark:text-neutral-300">
                        {item.company}
                      </p>

                      <p class="text-sm font-light text-neutral-600 dark:text-neutral-400 whitespace-pre-line">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Vamos nos conectar -->
          <div class="w-[360px] ml-8">
            <h2 class="mb-2 text-2xl font-bold text-neutral-900 dark:text-neutral-200">
              {aboutContent.connect.title}
            </h2>

            <div class="py-[30px]">
              <p class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg">
                {aboutContent.connect.description}
                {" "}
                <a href={aboutContent.connect.linkedin.href} class="underline text-neutral-900 dark:text-neutral-100 hover:opacity-80">
                  {aboutContent.connect.linkedin.text}
                </a>
                {" "}
                ou enviar um{" "}
                <a href={aboutContent.connect.email.href} class="underline text-neutral-900 dark:text-neutral-100 hover:opacity-80">
                  {aboutContent.connect.email.text}
                </a>
                .
              </p>
            </div>
          </div>
        </div>
      </section>

      <Footer />
    </div>
  </body>
</html>
