---
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("cases");

  // Usa slug do frontmatter (entry.data.slug), com fallback pro slug automático.
  return entries.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const {
  title,
  description,
  heroImage,
  stack,

  context,
  challenge,
  steps,

  resultHighlights,
  resultImage,
  resultImageAlt,

  links,
} = entry.data;

const githubUrl = links?.github;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Cases</title>
    <meta name="description" content={description ?? ""} />

    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initialTheme =
          savedTheme === "system" ? (prefersDark ? "dark" : "light") : savedTheme;

        if (initialTheme === "dark") document.documentElement.classList.add("dark");
        else document.documentElement.classList.remove("dark");
      })();
    </script>

    <style>
      .dot-hexagon-light {
        background-image: radial-gradient(circle, #80808045 1px, transparent 1px),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(circle, #ffffff35 1px, transparent 1px),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }
    </style>
  </head>

  <body class="bg-white dark:bg-black transition-colors duration-300">
    <!-- Fundo: só o grid -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 dot-hexagon-light dark:dot-hexagon-dark"></div>
    </div>

    <main class="relative z-10 min-h-screen flex flex-col">
      <Navigation />

      <!-- HERO / HEADER -->
      <header class="w-full mt-20">
        <div class="relative w-full">
          <div
            class="relative mx-auto max-w-6xl px-7 lg:px-0 overflow-hidden rounded-2xl border border-neutral-200/60 dark:border-neutral-800/60 bg-cover bg-center"
            style={heroImage ? `background-image:url(${heroImage});` : ""}
          >
            {/* overlay p/ legibilidade */}
            <div class="absolute inset-0 bg-black/55 dark:bg-black/60"></div>

            <div class:list={[
              "relative flex items-center justify-center text-center p-8 sm:p-10",
              heroImage ? "min-h-[280px] sm:min-h-[340px]" : "py-12 sm:py-14",
            ]}>
              <div class="max-w-3xl">
                <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
                  {title}
                </h1>

                {description && (
                  <p class="mt-3 text-base sm:text-lg text-white/85 whitespace-pre-line">
                    {description}
                  </p>
                )}
                {stack?.length ? (
                  <div class="mt-6 flex flex-wrap gap-2 justify-center">
                    {stack.map((item) => (
                      <span class="px-3 py-1 text-sm bg-white/15 text-white rounded-full border border-white/20">
                        {item}
                      </span>
                    ))}
                  </div>
                ) : null}
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- CONTEÚDO -->
      <article class="w-full max-w-6xl mx-auto mt-10 mb-12 px-7 lg:px-0">
        <!-- Contexto -->
        {context && (
          <section class="mt-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10">
              <div class="md:col-span-2 md:self-center">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                  Contexto
                </h2>
              </div>
              <div class="md:col-span-10">
                <div class="rounded-2xl border border-neutral-200/60 dark:border-neutral-800/60 bg-white/80 dark:bg-neutral-950/60 backdrop-blur-sm p-6">
                  <p class="text-base text-neutral-800 dark:text-neutral-200 whitespace-pre-line leading-relaxed">
                  {context}
                  </p>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Problema -->
        {challenge && (
          <section class="mt-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10">
              <div class="md:col-span-2 md:self-center">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                  Problema
                </h2>
              </div>
              <div class="md:col-span-10">
                <div class="rounded-2xl border border-neutral-200/60 dark:border-neutral-800/60 bg-white/80 dark:bg-neutral-950/60 backdrop-blur-sm p-6">
                  <p class="text-base text-neutral-800 dark:text-neutral-200 whitespace-pre-line leading-relaxed">
                  {challenge}
                  </p>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Solução -->
        {Array.isArray(steps) && steps.length > 0 && (
          <section class="mt-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10">
              <div class="md:col-span-2 md:self-center">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                  Solução
                </h2>
              </div>
              <div class="md:col-span-10">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {steps.map((step, idx) => (
                    <div class="rounded-2xl border border-neutral-200/60 dark:border-neutral-800/60 bg-white/80 dark:bg-neutral-950/60 backdrop-blur-sm p-5">
                      <div class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">
                        Etapa {idx + 1}
                      </div>
                      <div class="mt-2 text-base text-neutral-900 dark:text-neutral-100 leading-relaxed">
                        {step}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Resultados -->
        {(Array.isArray(resultHighlights) && resultHighlights.length > 0) || resultImage ? (
          <section class="mt-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-start">
              <div class="md:col-span-2 md:self-center">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                  Resultados
                </h2>
              </div>

              <div class="md:col-span-12">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                  <!-- Coluna esquerda: cards -->
                  <div class="space-y-4">
                    {Array.isArray(resultHighlights) && resultHighlights.map((txt) => (
                      <div class="rounded-2xl border border-neutral-200/60 dark:border-neutral-800/60 bg-white/80 dark:bg-neutral-950/60 backdrop-blur-sm p-5">
                        <p class="text-base text-neutral-900 dark:text-neutral-100 leading-relaxed">
                          {txt}
                        </p>
                      </div>
                    ))}
                  </div>

                  <!-- Coluna direita: imagem -->
                  {resultImage && (
                    <div class="rounded-2xl border border-neutral-200/60 dark:border-neutral-800/60 bg-white/80 dark:bg-neutral-950/60 backdrop-blur-sm p-4">
                      <img
                        src={resultImage}
                        alt={resultImageAlt ?? `Imagem de resultados: ${title}`}
                        class="w-full h-auto rounded-xl"
                        loading="lazy"
                      />
                    </div>
                  )}
                </div>
              </div>
            </div>
          </section>
        ) : null}

        <!-- CTA FINAL-->
        <section class="mt-14">
          <div class="rounded-2xl border border-blue-200/60 dark:border-blue-900/40 dark:border-neutral-800/60 bg-blue-50/60 dark:bg-blue-950/20 p-7 sm p-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <!-- CTA GitHub -->
              <div>
                <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
                  Explorar o código desta POC

                </h3>
                <p class="mt-2 text-neutral-700 dark:text-neutral-300 leading-relaxed">
                  Acesse o repositório no GitHub para consultar os dados, o código e a lógica utilizada nesta solução.
                </p>

                {githubUrl ? (
                  <a
                    href={githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex mt-4 items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold
                           bg-neutral-900 text-white hover:bg-neutral-800
                           dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200 transition"
                  >
                    Repositório GitHub
                  </a>
                ) : (
                  <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">
                    (Link do GitHub não informado nesta POC.)
                  </p>
                )}
              </div>

              <!-- CTA voltar -->
              <div>
                <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
                  Gostou desta solução?
                </h3>
                <p class="mt-2 text-neutral-700 dark:text-neutral-300 leading-relaxed">
                  Explore outras provas de conceito e veja como dados podem ser aplicados a diferentes problemas de negócio.
                </p>

                <a
                  href="/cases"
                  class="inline-flex mt-4 items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold
                           bg-neutral-900 text-white hover:bg-neutral-800
                           dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200 transition"
                >
                  Ver outras POCs
                </a>
              </div>
            </div>
          </div>
        </section>
      </article>

      <Footer />
    </main>
  </body>
</html>
