---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { projectsContent } from "../config/content.ts";

// Assume:
// - projectsContent.tracks: [{ key, label, description, anchor }, ...]
// - each project has: track
// - (optional) each project has: impact

const tracks = projectsContent.tracks ?? [];
const projectsByTrack = (key: string) =>
  projectsContent.projects.filter((p: any) => p.track === key);
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{projectsContent.meta.title}</title>
    <meta name="description" content={projectsContent.meta.description} />

    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initialTheme =
          savedTheme === "system" ? (prefersDark ? "dark" : "light") : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) document.documentElement.classList.add("dark");
              else document.documentElement.classList.remove("dark");
            }
          });
      });
    </script>

    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow-x: hidden;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
      section[class*="text-gray-700"] {
        margin: 0;
        padding: 0;
        flex-shrink: 0;
      }

      .dot-hexagon-light {
        background-image: radial-gradient(circle, #80808045 1px, transparent 1px),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(circle, #ffffff35 1px, transparent 1px),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
      }
    </style>
  </head>

  <body class="bg-white dark:bg-black transition-colors duration-300">
    <!-- Fundo: só o grid -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 dot-hexagon-light dark:dot-hexagon-dark"></div>
    </div>

    <main class="flex-1 relative z-10">
      <Navigation />

      <section class="relative z-20 max-w-6xl mx-auto mt-20 mb-12 px-7 lg:px-0">
        <div class="relative z-20 w-full mx-auto lg:mx-0">
          {/* BLOCO “EDITORIAL” COM LARGURA MENOR (≈720px) */}
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl">
              {projectsContent.title}
            </h2>

            {/* Permite <strong> etc vindo do content.ts */}
            <p
              class="mt-3 text-sm leading-6 text-neutral-700 dark:text-neutral-300 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg whitespace-pre-line"
              set:html={projectsContent.description}
            />

            {/* Chips de navegação com o MESMO estilo dos tags azuis */}
            {tracks.length ? (
              <div class="mt-6 flex flex-wrap gap-2">
                {tracks.map((t: any) => (
                  <a
                    href={`#${t.anchor}`}
                    class="px-3 py-1 text-xs rounded-full border backdrop-blur-sm
                           bg-blue-50/70 dark:bg-blue-950/25
                           text-blue-700 dark:text-blue-200
                           border-blue-200/60 dark:border-blue-900/35
                           hover:ring-1 hover:ring-blue-200/40 dark:hover:ring-blue-900/20"
                  >
                    {t.label}
                  </a>
                ))}
              </div>
            ) : null}
          </div>

          {/* Seções por trilha */}
          <div class="mt-10 space-y-14">
            {tracks.map((t: any) => {
              const items = projectsByTrack(t.key);
              if (!items.length) return null;

              return (
                <section id={t.anchor} class="scroll-mt-24">
                  <header class="mb-6">
                    <h3 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-2xl">
                      {t.label}
                    </h3>
                    <p class="mt-2 text-sm leading-6 text-neutral-700 dark:text-neutral-300 sm:text-base">
                      {t.description}
                    </p>
                  </header>

                  <div class="z-50 grid items-stretch w-full grid-cols-1 gap-7 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {items.map((project: any) => (
                      <a
                        href={project.href}
                        class="relative flex flex-col items-stretch duration-300 ease-out p-7 sm:p-4 group rounded-2xl
                              bg-white/80 dark:bg-neutral-950/60 backdrop-blur-sm
                              border border-neutral-200/60 dark:border-neutral-800/60
                              hover:border-blue-300/60 dark:hover:border-blue-900/40
                              hover:ring-1 hover:ring-blue-200/40 dark:hover:ring-blue-900/20"
                      >
                        <span class="absolute inset-0 z-20 block w-full h-full duration-300 ease-out bg-transparent border border-transparent border-dashed group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border group-hover:border-neutral-300 dark:group-hover:border-neutral-700 group-hover:border-dashed rounded-2xl group-hover:bg-white dark:group-hover:bg-black" />
                        <span class="absolute inset-0 z-10 block w-full h-full duration-300 ease-out border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-700 group-hover:translate-x-1 group-hover:translate-y-1" />

                        <span class="relative z-30 block duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
                          <span class="block w-full">
                            <img
                              src={project.image}
                              alt={project.title}
                              class="w-full h-auto rounded-lg aspect-[16/9] object-cover"
                            />
                          </span>

                          <span class="block w-full px-1 mt-5 mb-1 sm:mt-3">
                            <span class="flex items-center mb-0 text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
                              <span>{project.title}</span>
                              <svg
                                class="group-hover:translate-x-0 group-hover:translate-y-0 -rotate-45 translate-y-1 -translate-x-1 w-2.5 h-2.5 stroke-current ml-1 transition-all ease-in-out duration-200 transform"
                                viewBox="0 0 13 15"
                              >
                                <g
                                  stroke="none"
                                  stroke-width="1"
                                  fill="none"
                                  fill-rule="evenodd"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <g transform="translate(0.666667, 2.333333)" stroke="currentColor" stroke-width="2.4">
                                    <g>
                                      <polyline
                                        class="transition-all duration-200 ease-out opacity-0 delay-0 group-hover:opacity-100"
                                        points="5.33333333 0 10.8333333 5.5 5.33333333 11"
                                      />
                                      <line
                                        class="transition-all duration-200 ease-out transform -translate-x-1 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 group-hover:ml-0"
                                        x1="10.8333333"
                                        y1="5.5"
                                        x2="0.833333333"
                                        y2="5.16666667"
                                      />
                                    </g>
                                  </g>
                                </g>
                              </svg>
                            </span>

                            {/* IMPACT (1 linha) */}
                            {project.impact ? (
                              <span class="mt-2 block text-sm font-medium text-neutral-900 dark:text-neutral-100 line-clamp-1">
                                {project.impact}
                              </span>
                            ) : null}

                            <span class="mt-2 text-sm text-neutral-700 dark:text-neutral-300 block leading-relaxed line-clamp-3">
                              {project.description}
                            </span>

                            {project.stack?.length ? (
                              <div class="mt-4 flex flex-wrap gap-2">
                                {project.stack.map((tech: string) => (
                                  <span class="px-3 py-1 text-xs rounded-full border backdrop-blur-sm
                                               bg-blue-50/70 dark:bg-blue-950/25
                                               text-blue-700 dark:text-blue-200
                                               border-blue-200/60 dark:border-blue-900/35">
                                    {tech}
                                  </span>
                                ))}
                              </div>
                            ) : null}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>